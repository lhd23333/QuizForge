# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。

# MinerU API Token —— 在 https://mineru.net 的「API 管理」页面创建
MINERU_API_TOKEN=

# DeepSeek API Key —— 在 https://platform.deepseek.com 创建
DEEPSEEK_API_KEY=

# DeepSeek 模型，默认 deepseek-chat（即 DeepSeek-V3）
DEEPSEEK_MODEL=deepseek-chat

# MinerU 解析模型：vlm / pipeline / MinerU-HTML，默认 vlm（质量最佳）
MINERU_MODEL_VERSION=vlm

# 文档语言：ch / en 等，默认 ch（中文）
MINERU_LANGUAGE=ch
